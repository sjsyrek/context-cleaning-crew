{
  "enabledPlugins": {
    "greeter@local": true,
    "muted@local": false
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/big.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/bad-json.sh"
          }
        ]
      }
    ]
  }
}
